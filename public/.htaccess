# Security headers (defense against clickjacking, MIME sniffing, referrer leaks).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Content-hashed build output (Next.js changes the filename whenever the
# content changes) — safe to cache forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header unset Pragma
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Intent: unmatched paths should return a real 404, not Apache's 500
# (Ahrefs reports the 500 as a 5XX error). This directive alone does not
# achieve that on the current host — see the comment below.
ErrorDocument 404 /404.html

# NOT CURRENTLY EFFECTIVE ON PRODUCTION (verified 2026-08-28): extensionless
# unknown paths (e.g. /foo, /sitemap_index.xml) come back from this host as a
# raw 500, and the ErrorDocument directive above never fires for them. A
# mod_rewrite-based workaround was also tried (forcing a 404 status before
# any handler dispatch) and failed identically — a trivial unconditional
# RewriteRule redirect to an external URL didn't fire either (no Location
# header, still 500). That means AllowOverride for this docroot is not
# honoring FileInfo-category directives (ErrorDocument/RewriteRule) from this
# file at all; the "ErrorDocument" Apache mentions in its failure page is a
# separate, account/server-level default that is itself broken. Fixing this
# requires cPanel/WHM access to check AllowOverride for the domain's document
# root and the PHP/FastCGI handler mapping for extensionless requests — it
# cannot be fixed by editing this file.
