# Security headers (defense against clickjacking, MIME sniffing, referrer leaks).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Content-hashed build output (Next.js changes the filename whenever the
# content changes) — safe to cache forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header unset Pragma
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Unmatched paths must return a real 404, not Apache's 500.
# `output: "export"` writes each route as <slug>/index.html and Next emits a
# built-in out/404.html; without this directive Bluehost's Apache answers 500
# for every unknown path (including legacy URLs such as /sitemap_index.xml and
# /wp-sitemap.xml), which Ahrefs reports as a 5XX error.
ErrorDocument 404 /404.html

# Bluehost's PHP/FastCGI handler answers 500 (not 404) for paths that don't
# resolve to a real file or directory, so ErrorDocument 404 above never fires
# for them, and even ErrorDocument 500 fails the same way because the broken
# handler state carries into that subrequest too. Intercept these paths in
# mod_rewrite instead — it runs before Apache hands the request to that
# handler — and force a real 404 status directly, bypassing the handler
# entirely for anything that isn't an existing file or directory.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^__rewrite_diag__$ https://example.com/ [R=302,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ - [R=404,L]
</IfModule>
