# Security headers (defense against clickjacking, MIME sniffing, referrer leaks).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Content-hashed build output (Next.js changes the filename whenever the
# content changes) — safe to cache forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header unset Pragma
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Unmatched paths must return a real 404, not Apache's 500.
# `output: "export"` writes each route as <slug>/index.html and Next emits a
# built-in out/404.html; without this directive Bluehost's Apache answers 500
# for every unknown path (including legacy URLs such as /sitemap_index.xml and
# /wp-sitemap.xml), which Ahrefs reports as a 5XX error.
ErrorDocument 404 /404.html

# Stopgap: extensionless unknown paths (e.g. /foo, /sitemap_index.xml) come
# back from Bluehost's PHP/FastCGI handler as a raw 500, not 404, so the
# ErrorDocument 404 above never fires for them. This at least shows the 404
# page's content instead of Apache's default error page; the HTTP status for
# these paths still reports 500 until the account-level handler config is
# fixed in cPanel.
ErrorDocument 500 /404.html
